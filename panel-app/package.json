{
  "name": "aidipanel-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Frontend build pipeline for AidiPanel — local Tailwind CSS build plus vendored fonts/JS so the panel ships no third-party CDN dependencies.",
  "scripts": {
    "test": "node --test ../tests/unit/frontend_dependencies_test.mjs",
    "build:css": "tailwindcss -i resources/css/tailwind.css -o public/assets/tailwind.css --minify",
    "build:assets": "node build/vendor-assets.mjs",
    "icons": "node build/sync-icons.mjs",
    "build": "npm run build:css && npm run build:assets && npm run icons",
    "watch:css": "tailwindcss -i resources/css/tailwind.css -o public/assets/tailwind.css --watch"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@tabler/icons": "3.51.0",
    "@tailwindcss/cli": "4.3.5",
    "alpinejs": "3.17.5",
    "apexcharts": "4.7.0",
    "esbuild": "0.28.2",
    "jsdom": "31.0.0",
    "tailwindcss": "4.3.5"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-php": "6.0.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.15",
    "codemirror": "6.0.2",
    "qrcode-generator": "2.0.4"
  }
}
